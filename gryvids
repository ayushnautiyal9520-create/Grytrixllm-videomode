#!/usr/bin/env bash
set -euo pipefail
GRYVIDS_SOURCE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="$GRYVIDS_SOURCE_DIR${PYTHONPATH:+:$PYTHONPATH}"
source "$GRYVIDS_SOURCE_DIR/scripts/bootstrap_linux.sh"
freevideo_bootstrap_linux cli "$@"
(( FREEVIDEO_BOOTSTRAP_DONE == 0 )) || exit 0
exec "$FREEVIDEO_BOOTSTRAP_PYTHON" -B -X utf8 -m freevideo_engine.managed "${FREEVIDEO_BOOTSTRAP_ARGS[@]}"
